<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- What shows under the icon. Changing this is a one-line change; the applicationId is not. -->
    <string name="app_name">Cycle</string>

    <!-- ============================================================ -->
    <!-- Today screen -->

    <!-- The main button. "Undo" unmarks today only; it does not end the period -->
    <string name="today_undo">Undo</string>
    <!-- The main button mid-period: confirm that today is a bleeding day -->
    <string name="today_bleeding_today">Bleeding today</string>
    <!-- The main button otherwise: mark today as the first day of a period -->
    <string name="today_period_started">Period started</string>
    <!-- Opens the calendar (noun as a button) -->
    <string name="today_calendar">Calendar</string>
    <!-- Opens the system share sheet to send a one-line summary -->
    <string name="today_send_to">Send to…</string>
    <string name="today_import_history">Import history</string>
    <!-- Opens the save dialog for a backup file (verb) -->
    <string name="today_back_up">Back up…</string>
    <!-- The quiet line near the foot: %1$s and %2$s are lengths such as "29 days" or "27–31 days" -->
    <string name="today_cycle_and_period">Cycle %1$s · period %2$s</string>
    <!-- A length that did not vary; %1$d is the number of days -->
    <string name="today_span_days">%1$d days</string>
    <!-- A length as a range, e.g. 27–31 days -->
    <string name="today_span_range_days">%1$d–%2$d days</string>

    <!-- The big count and the line under it -->
    <!-- %1$d is the day of the current period, e.g. "Day 3" over "of your period" -->
    <string name="today_day_n">Day %1$d</string>
    <string name="today_of_your_period">of your period</string>
    <!-- Under "Day N" when today has not been confirmed as a bleeding day -->
    <string name="today_not_recorded_yet">not recorded yet</string>
    <string name="today_no_history">No history yet</string>
    <string name="today_mark_a_day">Mark a day to begin</string>
    <!-- The count: days until the next period, or days past the expected date -->
    <plurals name="today_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <!-- Under "N days": the period is N days away -->
    <string name="today_until_your_period">until your period</string>
    <!-- Big count when the period is expected tomorrow -->
    <string name="today_tomorrow">Tomorrow</string>
    <!-- Big count when the period is expected today -->
    <string name="today_today">Today</string>
    <!-- Under "Tomorrow" or "Today" -->
    <string name="today_period_expected">your period is expected</string>
    <!-- Under "N days" once the expected date has passed; deliberately not "late" -->
    <string name="today_later_than_expected">later than expected</string>

    <!-- ============================================================ -->
    <!-- The one line "Send to…" sends: written in the first person, to a partner -->

    <!-- %1$d is the day of the current period -->
    <string name="summary_day_of_period">Day %1$d of my period.</string>
    <!-- Mid-period, today not yet marked. %1$s is a weekday and date, e.g. "Wednesday 14 April" -->
    <string name="summary_started">Period started %1$s.</string>
    <string name="summary_nothing_yet">Nothing recorded yet.</string>
    <!-- Every "expected" line says "expected", never "due", and a passed date is "later than
         expected", never "late": the date is an estimate, and when it misses, the estimate was wrong.
         Each has a _rough twin, used while there is not enough history yet for her own numbers. -->
    <!-- Only used for two days or more. %1$s is a weekday and date, e.g. "Wednesday 14 April"; %2$d is the number of days -->
    <plurals name="summary_expected_in">
        <item quantity="one">Period expected %1$s, %2$d day away.</item>
        <item quantity="other">Period expected %1$s, %2$d days away.</item>
    </plurals>
    <plurals name="summary_expected_in_rough">
        <item quantity="one">Period expected %1$s, %2$d day away (rough — not enough history yet).</item>
        <item quantity="other">Period expected %1$s, %2$d days away (rough — not enough history yet).</item>
    </plurals>
    <string name="summary_expected_tomorrow">Period expected tomorrow.</string>
    <string name="summary_expected_tomorrow_rough">Period expected tomorrow (rough — not enough history yet).</string>
    <string name="summary_expected_today">Period expected today.</string>
    <string name="summary_expected_today_rough">Period expected today (rough — not enough history yet).</string>
    <!-- %1$d is how many days past the expected date -->
    <plurals name="summary_later">
        <item quantity="one">Period is %1$d day later than expected.</item>
        <item quantity="other">Period is %1$d days later than expected.</item>
    </plurals>
    <plurals name="summary_later_rough">
        <item quantity="one">Period is %1$d day later than expected (rough — not enough history yet).</item>
        <item quantity="other">Period is %1$d days later than expected (rough — not enough history yet).</item>
    </plurals>

    <!-- ============================================================ -->
    <!-- Calendar -->

    <!-- The button back to the today screen -->
    <string name="calendar_today">Today</string>
    <!-- The key under the month: what each mark means -->
    <!-- A filled circle: a bleeding day that was recorded -->
    <string name="calendar_key_recorded">Recorded</string>
    <!-- An outlined circle: a day the next period is expected -->
    <string name="calendar_key_expected">Expected</string>
    <string name="calendar_key_fertile">Fertile</string>
    <string name="calendar_key_ovulation">Ovulation</string>

    <!-- ============================================================ -->
    <!-- Day screen -->

    <!-- A toggle; the label says the current state -->
    <string name="day_bleeding">Bleeding</string>
    <string name="day_not_bleeding">Not bleeding</string>
    <!-- How heavy the bleeding is -->
    <string name="day_intensity_light">Light</string>
    <string name="day_intensity_medium">Medium</string>
    <string name="day_intensity_heavy">Heavy</string>
    <!-- Section heading (noun) -->
    <string name="day_heading_mood">Mood</string>
    <string name="day_heading_symptoms">Symptoms</string>
    <!-- The offered mood words, each a toggle on the day. Short: a word has to fit a chip on a
         small screen. What is saved is the English word, so a translation here never changes a
         saved day. -->
    <string name="day_mood_happy">Happy</string>
    <string name="day_mood_calm">Calm</string>
    <string name="day_mood_tired">Tired</string>
    <!-- Low in mood -->
    <string name="day_mood_low">Low</string>
    <string name="day_mood_anxious">Anxious</string>
    <string name="day_mood_irritable">Irritable</string>
    <string name="day_mood_energetic">Energetic</string>
    <!-- The offered symptom words, the same way as the moods -->
    <string name="day_symptom_cramps">Cramps</string>
    <string name="day_symptom_headache">Headache</string>
    <string name="day_symptom_backache">Backache</string>
    <string name="day_symptom_bloating">Bloating</string>
    <!-- Sore to the touch, as breasts can be before a period -->
    <string name="day_symptom_tender">Tender</string>
    <string name="day_symptom_nausea">Nausea</string>
    <string name="day_symptom_acne">Acne</string>
    <!-- Food cravings -->
    <string name="day_symptom_cravings">Cravings</string>
    <!-- Restless, unable to settle -->
    <string name="day_symptom_restless">Restless</string>
    <!-- A toggle: sex on this day -->
    <string name="day_intimacy">Intimacy</string>
    <!-- Section heading (noun) -->
    <string name="day_heading_note">Note</string>
    <!-- Closes the day and goes back -->
    <string name="day_done">Done</string>
    <!-- After the offered words: add a word of your own -->
    <string name="day_tag_other">Other…</string>
    <!-- Beside the box where you type your own word (verb) -->
    <string name="day_tag_add">Add</string>

    <!-- ============================================================ -->
    <!-- About dialog -->

    <!-- %1$s is the version number -->
    <string name="about_version">Cycle %1$s</string>
    <string name="about_privacy">No permissions. No network. What you record stays on this phone.</string>
    <string name="about_licence">GNU General Public License v3</string>
    <string name="about_close">Close</string>
    <!-- Opens the donation page -->
    <string name="about_feed_llamas">feed the llamas</string>
    <string name="about_no_browser">There is no browser on this phone to open that with.</string>
</resources>
